DJANGO_DEBUG=true
# Set a unique secret before deployment. Blank uses a development-only fallback.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Catalogue & language (Saketh). Real values go in .env or .env.local — never commit them.
ELASTIC_URL=
ELASTIC_API_KEY=
# memory | elastic — memory is the default and the demo fallback
SEARCH_BACKEND=memory
# Used only by compile() via the OpenAI Agents SDK
OPENAI_API_KEY=
