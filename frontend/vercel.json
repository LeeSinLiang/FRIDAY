{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://friday-hackmit-api.vercel.app/api/:path*" },
    { "source": "/_allauth/:path*", "destination": "https://friday-hackmit-api.vercel.app/_allauth/:path*" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/rooms", "destination": "/index.html" },
    { "source": "/room/:id", "destination": "/index.html" },
    { "source": "/cart", "destination": "/index.html" },
    { "source": "/account/:path*", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }]
}
